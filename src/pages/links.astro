---
import { getEntry, render } from "astro:content";
import site from "../data/site.json";
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";

// content lives in src/content/pages/links.md
const page = await getEntry("pages", "links");
if (!page) throw new Error("missing src/content/pages/links.md");
const { Content } = await render(page);
---

<Base title="links" heading={site.headers.links}>
  <Panel title={page.data.title}>
    <div class="prose"><Content /></div>
  </Panel>
</Base>
