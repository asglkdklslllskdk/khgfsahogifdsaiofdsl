---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Panel from "../../components/Panel.astro";
import { getPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <Panel title="post" footer={post.data.draft ? "draft" : undefined}>
    <h2 class="post-title">{post.data.title}</h2>
    <p class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
    <div class="prose"><Content /></div>
    <p class="back"><a href="/posts/">&lt;- all posts</a></p>
  </Panel>
</Base>
