---
// Full-screen fractal. Unlisted: not in the menu, not in the sitemap, and marked
// noindex so search engines leave it out. Reachable at /fractal/ only by link.
import site from "../data/site.json";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>fractal | {site.name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      html, body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #000;
        color: #fff;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      #fractal {
        position: fixed;
        inset: 0;
        margin: 0;
        overflow: hidden;
        white-space: pre;
        font-family: monospace;
        user-select: none;
      }
      #hud {
        position: fixed;
        left: 1ch;
        bottom: 0.65em;
        margin: 0;
        padding: 0 1ch;
        font: 10pt/1.3 monospace;
        background: #000;
        opacity: 0.8;
        white-space: pre;
      }
      #hud[hidden] { display: none; }
    </style>
  </head>
  <body>
    <pre id="fractal" aria-hidden="true"></pre>
    <pre id="hud"></pre>
    <script>
      import "../scripts/fractal-page.js";
    </script>
  </body>
</html>
